/**
 * IoT Fire Detection System - ESP32 Hardware Configuration Template
 * 
 * Copy this file to "config.h" and insert your local Wi-Fi and server credentials.
 * NEVER commit your real Wi-Fi password or API secrets to public repositories!
 */

#ifndef CONFIG_H
#define CONFIG_H

// ==========================================
// 1. Wi-Fi Configuration
// ==========================================
// Replace with your 2.4GHz Wi-Fi network SSID and password
// (Note: ESP32 only supports 2.4GHz networks, not 5GHz)
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// ==========================================
// 2. Backend Server & Ingestion Endpoint
// ==========================================
// When running locally: Use your computer's LAN IP, e.g. "http://192.168.1.50:8000/api/readings"
// When deployed on Render: Use HTTPS endpoint, e.g. "https://iot-fire-detection-backend.onrender.com/api/readings"
const char* BACKEND_SERVER_URL = "http://192.168.1.100:8000/api/readings";

// Device API key matching DEVICE_API_KEY in the backend .env configuration
const char* DEVICE_API_KEY = "test_device_key_12345";

// Unique Device ID registered for this ESP32 hardware unit
const char* DEVICE_ID = "ESP32_FLAME_STATION_01";

// ==========================================
// 3. Hardware Pin Assignments (DevKit V1)
// ==========================================
const int PIN_FLAME_SENSOR = 27;  // Digital output of IR Flame Sensor Module
const int PIN_RED_LED      = 26;  // Red Alert LED (Active when flame detected)
const int PIN_GREEN_LED    = 25;  // Green Safe LED (Active when no flame)

// ==========================================
// 4. Sensor Logic & Reporting Timing
// ==========================================
// Standard IR flame sensors output LOW when detecting infrared flame emission
const int FLAME_DETECTED_LOGIC = 0;  // 0 = LOW (Flame present), 1 = HIGH (Safe)

// Telemetry Intervals (in milliseconds)
const unsigned long HEARTBEAT_INTERVAL_MS = 4000;   // Routine heartbeat telemetry (every 4 seconds)
const unsigned long ALARM_RETRY_INTERVAL_MS = 1500; // Rapid reporting during active flame event (every 1.5s)
const unsigned long SENSOR_SAMPLE_INTERVAL_MS = 100; // Local physical sensor poll rate (10 times per second)

#endif // CONFIG_H

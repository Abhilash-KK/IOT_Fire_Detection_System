# ==========================================
# IoT Fire Detection System - Environment Config
# ==========================================

# Environment Mode: development / production / test
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Connection
# In Render: Provided automatically as DATABASE_URL (or Internal Database URL)
# Example local postgres: postgresql+psycopg2://user:password@localhost:5432/fire_detection_db
# Example Render format: postgresql://username:password@dpg-xxxxx.render.com/fire_detection_db
DATABASE_URL=sqlite:///./fire_detection.db

# Device API Key for ESP32 Ingestion authentication (Passed in X-API-Key header)
DEVICE_API_KEY=fire_detector_secret_key_change_me_in_production

# CORS Allowed Origins (Comma-separated for multiple origins, or * for open dev)
# In production on Render: Set to your frontend URL, e.g. https://iot-fire-detection.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Device Offline Threshold in seconds (dashboard flags device offline if no ping received)
DEVICE_OFFLINE_THRESHOLD_SECONDS=30
